# LLM (OpenAI-compatible provider adapter)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# Optional OpenRouter app metadata
# OPENROUTER_HTTP_REFERER=https://github.com/pandacover/world-weaver
# OPENROUTER_X_TITLE=world-weaver

# Character long-term memory (optional for local UI smoke)
SUPERMEMORY_API_KEY=

# Local SQLite home
# WORLD_WEAVER_HOME=~/.world-weaver
